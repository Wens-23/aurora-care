# Secret used to sign session cookies. Change this in production.
JWT_SECRET=change-this-to-a-long-random-string

# Admin portal credentials (used for the separate /admin/login page)
ADMIN_ID=admin@aurora_care
ADMIN_PASSWORD=admin@aurora123

# Optional: configure these to send real booking-confirmation emails.
# If left unset, emails are just logged and stored for viewing under
# Admin Dashboard -> Notifications instead of actually being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
